# Application
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=products_service
DB_SYNCHRONIZE=false
DB_LOGGING=true

# Messaging
RABBITMQ_URL=amqp://guest:guest@localhost:5672
# Exchange topic compartido donde identity-service publica identity.* (ver Event Catalog)
RABBITMQ_EXCHANGE=eciexpress_events

# Azure Service Bus opcional para despliegues en Azure
SERVICE_BUS_CONNECTION_STRING=
SERVICE_BUS_FULLY_QUALIFIED_NAMESPACE=
SERVICE_BUS_TOPIC=eciexpress_events
SERVICE_BUS_SUBSCRIPTION=products-service

# Identity Service (réplica local de Stores)
IDENTITY_SERVICE_URL=http://localhost:3001

# Azure Blob Storage — contenedor ÚNICO para imágenes y modelos 3D de producto.
# Rutas: products/<id>/images/<front|left|back>.<ext> y products/<id>/models/model.glb
BLOB_CONNECTION_STRING=
BLOB_PRODUCTS_CONTAINER=products

# Servicio de IA que genera el modelo 3D a partir de 3 imágenes en Base64
PRODUCT_AI_GENERATE_URL=
PRODUCT_AI_TIMEOUT_MS=600000
